{
  "name": "key-visor",
  "version": "1.0.0",
  "description": "Chiikawa Usagi Key Visor",
  "license": "ISC",
  "author": "",
  "type": "commonjs",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "echo \"Error: no test specified\" && exit 1",
    "postinstall": "electron-builder install-app-deps",
    "pack": "electron-builder"
  },
  "devDependencies": {
    "electron": "^41.7.1",
    "electron-builder": "^24.13.3",
    "electron-rebuild": "^3.2.9"
  },
  "dependencies": {
    "uiohook-napi": "^1.5.5"
  },
  "build": {
    "appId": "com.keyvisor",
    "productName": "Chiikawa Key Visor",
    "directories": {
      "buildResources": "assets",
      "output": "dist",
      "app": "."
    },
    "win": {
      "target": ["nsis"],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true 
    }
  }
}
